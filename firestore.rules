rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all (prevents unauthorized access to unspecified collections)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global authentication and authorization helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bhargavkhatri2302@gmail.com' ||
        request.auth.token.email == 'admin@bgkwear.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Outfits Collection (Luxury Couture Catalog)
    match /outfits/{outfitId} {
      // Public read for outfits so buyers can browse and search items
      allow get, list: if true;

      // Only authenticated users can list an outfit; creator ownership is strictly enforced
      allow create: if isSignedIn()
        && isValidId(outfitId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.sellerId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid ||
          isAdmin()
        );

      // Only the legitimate creator/owner or admin can update the outfit!
      // (Allows public counter increments for viewsCount/likesCount)
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'reviews', 'reviewsCount', 'rating', 'updatedAt'])
      ) || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          (resource.data.seller != null && resource.data.seller.id == request.auth.uid) ||
          isAdmin()
        ) && (
          // Strictly prevent transferring ownership
          request.resource.data.userId == resource.data.userId
        )
      );

      // ONLY the legitimate creator/owner or admin can delete! Third parties cannot delete.
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.seller != null && resource.data.seller.id == request.auth.uid) ||
        isAdmin()
      );
    }

    // 2. Users Collection (Profile Security & PII Protection)
    match /users/{userId} {
      // Authenticated users can view public profile details (boutique name, avatar, bio)
      allow get: if isSignedIn();

      // Only the account owner or admin can list/query user records (blocks user enumeration/scraping)
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Only the account owner or admin can create, update, or delete profile metadata
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Wishlist Collection (Strict User Isolation)
    match /wishlist/{wishlistId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. Rental Orders Collection (Buyer & Seller Privacy)
    match /rentalOrders/{orderId} {
      allow get: if isSignedIn() && (
        resource == null || 
        resource.data.renterId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.renterId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.renterId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.renterId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.renterId == request.auth.uid || 
        isAdmin()
      );
    }

    // 5. Purchase Orders Collection (Direct Buy Isolation)
    match /purchaseOrders/{orderId} {
      allow get: if isSignedIn() && (
        resource == null || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 6. Reviews Collection
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.reviewerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 7. Notifications Collection (Strict User Isolation)
    match /notifications/{notifId} {
      allow get: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // 8. Chats & Direct Messages Collection (Participant Isolation)
    match /chats/{chatId} {
      allow get: if isSignedIn() && (
        resource == null || 
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          request.resource.data.senderId == request.auth.uid &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin())
        );
        allow update, delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 9. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
